{
  "name": "room-booking-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "room-booking-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F2.5",
    "F2.6",
    "F2.7",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4",
    "F3.5",
    "F3.6"
  ],
  "description": "The single backend for rooms and bookings: lists active rooms and per-day availability (8:00-18:00 one-hour slots, up to 30 days ahead), creates bookings of consecutive free slots with no overlap, lists and cancels the caller's own bookings, and lets the facilities admin add, edit, deactivate and reactivate rooms and cancel any booking with a reason. Deactivating a room cancels its future bookings. It does not serve the UI and does not issue tokens.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "bookings-db",
      "description": "Stores rooms and bookings.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "room-booking-l29b-eb468f92",
        "envBindings": {
          "dbname": "BOOKINGS_DB_DBNAME",
          "host": "BOOKINGS_DB_HOST",
          "password": "BOOKINGS_DB_PASSWORD",
          "port": "BOOKINGS_DB_PORT",
          "user": "BOOKINGS_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Verifies the signed-in caller; the gateway forwards the caller's identity.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "room-booking-l29b-5a4f26d3",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
