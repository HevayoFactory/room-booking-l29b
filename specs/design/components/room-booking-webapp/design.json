{
  "name": "room-booking-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "room-booking-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F2.5",
    "F2.6",
    "F2.7",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4",
    "F3.5",
    "F3.6"
  ],
  "description": "The single browser app for both roles: staff browse rooms and a day's availability, book consecutive slots and manage their own bookings; the facilities admin manages rooms and cancels bookings from the day view. It is one bundle because both roles share one lifecycle; it holds no data of its own.",
  "dependencies": [
    {
      "kind": "component",
      "name": "room-booking-api",
      "description": "Loads rooms and availability, creates and cancels bookings, manages rooms.",
      "wiring": {
        "endpoint": {
          "component": "room-booking-l29b-room-booking-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "ROOM_BOOKING_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs users in through SSO.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "room-booking-l29b-5a4f26d3",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
